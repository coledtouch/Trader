# AI Trader settings. Copy this file to .env, fill in the blanks, then `chmod 600 .env` on Linux.
# On Windows, protect .env and its parent folder with Windows ACLs; Unix modes do not do that.
#
#   cp .env.example .env && chmod 600 .env && nano .env
#
# Rules for this file:
# - One NAME=value per line. Put comments on their own line (never after a value).
# - Leave a secret empty until you have it. Never commit .env (it is in .gitignore).
# - Wrap values that contain spaces in single quotes. For TWS_PASSWORD use letters and
#   digits only: a $ (or other symbol) can silently cut the password short on its way to
#   the gateway. Check what arrived (prints only the length):
#   docker compose exec ib-gateway sh -c 'printf %s "$TWS_PASSWORD" | wc -c'
# - After any change: `docker compose up -d` (recreates what changed).
#
# Trading settings you change from the web UI (universe, risk limits, autopilot, AI model,
# enabled setups and monthly operating-cost estimates)
# live in the database, not here. This file holds secrets and server wiring.
# New daily targets default to 0 (off); existing saved targets are retained.
# Operating costs default to unknown, not free. Current hosting dashboard estimate:
# $24/month; data cost remains unknown pending subscription approval. Set them in the UI.

# ===================================================================== which services run
# Empty = simulator only (no IB Gateway). Set to ibkr once IBKR credentials are below.
COMPOSE_PROFILES=

# ===================================================================== app: storage
# docker-compose sets this to /data inside the container (./data on the server).
TRADER_DATA_DIR=./data

# ===================================================================== app: web and security
# Encrypts the stored 2FA secret. Leave empty: `python -m trader setup` generates it and
# writes it here. Back it up (password manager): without it the 2FA secret cannot be read.
TRADER_SECRET_KEY=
# Listening address. docker-compose overrides these to 0.0.0.0:8000 inside the container.
TRADER_HOST=127.0.0.1
TRADER_PORT=8000
# Host names the app answers to. Keep localhost and 127.0.0.1 (the container health check).
TRADER_ALLOWED_HOSTS=desk.kaxo.dev,localhost,127.0.0.1
# The address your browser uses. Changes from any other origin are refused.
TRADER_PUBLIC_ORIGINS=https://desk.kaxo.dev
# true behind HTTPS (Cloudflare). false only for plain http://localhost testing.
TRADER_COOKIE_SECURE=true
TRADER_SESSION_IDLE_MINUTES=30
TRADER_SESSION_MAX_HOURS=12
# Failed logins allowed per IP in 15 minutes, and in total before all logins lock.
TRADER_LOGIN_MAX_ATTEMPTS_PER_IP=5
TRADER_LOGIN_LOCKOUT_FAILURES=10
# true because cloudflared is the only way in. The visitor IP is CF-Connecting-IP only.
# If that header is missing, the app uses the socket peer. It does not trust X-Forwarded-For.
TRADER_TRUST_PROXY_HEADERS=true
# Cloudflare Access check. Fill BOTH to turn it on.
# Required when TRADER_ALLOW_LIVE=true: the app refuses to start if either value is empty,
# so a live account is never exposed with this check off. Simulator and paper mode
# (TRADER_ALLOW_LIVE=false) may leave both empty.
# Only one filled in (e.g. a misspelled name) is always an error: the app refuses to start.
# Team domain: Zero Trust > Settings > Team name and domain, e.g. yourteam.cloudflareaccess.com
TRADER_CF_ACCESS_TEAM_DOMAIN=
# Audience tag: Zero Trust > Access > Applications > desk > Configure > "Application Audience (AUD) Tag"
TRADER_CF_ACCESS_AUD=

# ===================================================================== app: broker
# sim = offline simulator with fake money (safe default). ibkr = Interactive Brokers.
TRADER_BROKER=sim
# docker-compose sets the host to ib-gateway. Port: 4004 = paper, 4003 = live.
TRADER_IB_HOST=ib-gateway
TRADER_IB_PORT=4004
TRADER_IB_CLIENT_ID=17
# 3 = free 15-minute-delayed data (the default). 1 = live data (needs IBKR market data
# subscriptions/entitlement). Delayed stock data blocks PAPER and LIVE entries and paid
# entry analysis; existing exits remain managed. Keep 3 for diagnostics while approval is
# pending. After approval and paper sharing, request 1 and verify delivered quote flags.
# Setting 1 neither buys nor approves a subscription. A fresh receipt timestamp does not
# make a delayed exchange price real-time. See docs/DEPLOY.md, Part B.
TRADER_IB_MARKET_DATA_TYPE=3
# Optional: pin one account id (leave empty if the login has a single account).
TRADER_IB_ACCOUNT=
TRADER_IB_CRYPTO_EXCHANGE=ZEROHASH
# Your IBKR Pro pricing plan, used for fee estimates: tiered or fixed.
TRADER_COMMISSION_PLAN=tiered
# Real-money gate. Keep false until paper and shadow mode have proven themselves. Even when
# true, live orders also need the owner to "arm" live trading in the UI with a 2FA code.
# Starting the app with false clears that arm: after switching back to true, arm again.
# true also requires both TRADER_CF_ACCESS_* values above. The app will not start without them.
TRADER_ALLOW_LIVE=false

# ===================================================================== crypto stop watchdog
# A second process (the crypto-watchdog container, started with COMPOSE_PROFILES=ibkr).
# IBKR cannot hold a crypto stop, so this process sells crypto the bot opened when the
# app's heartbeat goes stale, and also when the kill switch is on. It never buys.
# It uses its own gateway client id (must differ from TRADER_IB_CLIENT_ID). It cannot
# sell if the gateway itself is down: there is no broker-side crypto stop to fall back on.
# false: the process stays up and does not connect. auto: paper may sell; live sells only
# when TRADER_ALLOW_LIVE=true. With that gate off, a live account gets alerts and no
# watchdog sells. off: watch-only (alert, never send). Leave this at off for the first
# few days.
# Stopping the app container for longer than the flatten timeout sells all bot crypto.
# A redeploy that is back within the stale timeout (45s at the default monitor interval)
# does not. A longer monitor interval in Settings raises both timeouts.
TRADER_WATCHDOG_ENABLED=true
TRADER_WATCHDOG_STALE_SECONDS=45
TRADER_WATCHDOG_FLATTEN_SECONDS=180
TRADER_WATCHDOG_POLL_SECONDS=10
TRADER_WATCHDOG_RETRY_SECONDS=20
TRADER_WATCHDOG_CLIENT_ID=18
TRADER_WATCHDOG_ORDERS=auto

# ===================================================================== app: AI
# The default decision mode (Settings > Decision mode) is consensus: a BUY goes out only
# when Claude AND Grok both buy the same stock. It needs both keys. With one key that model
# decides alone, with none the bot makes rules-only decisions; the dashboard says which.
# Claude API key (https://platform.claude.com > API keys, prepaid credit, auto-reload off).
ANTHROPIC_API_KEY=
# xAI (Grok) API key (https://console.x.ai > API Keys). Prepaid API credits, separate from
# a SuperGrok or X Premium subscription (those do not include API access). Set a spending
# limit there if offered.
XAI_API_KEY=
# Grok model id. Check console.x.ai for the current name.
TRADER_XAI_MODEL=grok-4.7
# Grok prices in USD per million tokens, used for the daily AI budget. Defaults are
# third-party figures for grok-4.7 (not confirmed by xAI): correct them if the console
# shows different prices.
TRADER_XAI_PRICE_INPUT=2.0
TRADER_XAI_PRICE_CACHED_INPUT=0.5
TRADER_XAI_PRICE_OUTPUT=6.0

# ===================================================================== app: phone alerts
# App alerts need no setting here: turn them on per device in the app (Settings > Phone
# alerts). Optional ntfy as well or instead: the topic URL, e.g.
# https://ntfy.sh/<long-random-name>. Treat it as a secret.
TRADER_NTFY_URL=
TRADER_NTFY_TOKEN=
# Optional dead-man's switch: the ping URL of a healthchecks.io check (https://hc-ping.com/...).
# The app pings it every TRADER_HEALTHCHECK_EVERY_SECONDS while the engine is alive, and
# healthchecks.io alerts you (by e-mail, or the same ntfy topic) when the pings stop: the
# droplet is down, the app crashed or hung, or IBKR is unreachable. Treat it as a secret.
TRADER_HEALTHCHECK_URL=
TRADER_HEALTHCHECK_EVERY_SECONDS=60

# ===================================================================== app: backups
# Nightly copy of data/trader.db to data/backups/trader-YYYY-MM-DD.db (mode 600), keeping
# the newest TRADER_BACKUP_KEEP. On the droplet only: copy one to your laptop now and then.
TRADER_BACKUP_ENABLED=true
TRADER_BACKUP_KEEP=14

# ===================================================================== app: misc
TRADER_MARKET_TIMEZONE=America/New_York
TRADER_LOG_LEVEL=INFO
TRADER_SIM_SEED=7
# Fake money for the simulator.
TRADER_SIM_STARTING_CASH=600

# ===================================================================== IB Gateway container
# Only used when COMPOSE_PROFILES=ibkr. Paper: the paper account's username and password
# (no phone approval needed). Live: your normal IBKR username and password (approve the
# IB Key push on your phone at every full login).
TWS_USERID=
TWS_PASSWORD=
# paper or live. Must match TRADER_IB_PORT (paper 4004, live 4003).
TRADING_MODE=paper
# no = the bot may place orders. yes = the gateway refuses all orders (handy for shadow mode).
READ_ONLY_API=no
# On a missed phone approval: restart the login and push again.
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
# Set to the device name IBKR shows if you have more than one 2FA device, e.g. IB Key.
TWOFA_DEVICE=
# Daily restart without a new 2FA (gateway clock, hh:mm AM/PM). Outside market hours.
AUTO_RESTART_TIME='11:45 PM'
# Weekly full re-login on Sundays at this time (24h hh:mm, gateway clock, after 01:00 ET).
# With live credentials this sends the weekly IB Key push to your phone.
TWS_COLD_RESTART=10:00
# primary = the bot's gateway session keeps running if you log in elsewhere.
EXISTING_SESSION_DETECTED_ACTION=primary
TIME_ZONE=America/New_York
# Empty = the gateway's VNC screen is off (normal). Only set it for troubleshooting.
VNC_SERVER_PASSWORD=

# ===================================================================== Cloudflare Tunnel
# Token of the tunnel "desk" (Networking > Tunnels > desk > Add a replica: the eyJ... string).
TUNNEL_TOKEN=

# ===================================================================== image build
# Must match `id -u` and `id -g` of the server user that owns ./data (1000 on a new droplet).
APP_UID=1000
APP_GID=1000
